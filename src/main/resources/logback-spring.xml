<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Path log sesuai log4j kamu -->
    <property name="LOG_PATH" value="/var/log/spreadsheet/app-logs" />

    <!-- 1. Console Appender (stdout) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n</pattern>
        </encoder>
    </appender>

    <!-- Macro untuk Rolling File (Biar gak nulis berulang-ulang) -->
    <!-- Logback menggabungkan TimeBased dan SizeBased di SizeAndTimeBasedRollingPolicy -->

    <!-- 2. Stream Appender -->
    <appender name="StreamFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/stream.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/stream.%d{yyyyMMdd.HHmmss}.%i.gz</fileNamePattern>
            <maxFileSize>1000MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss:SSS} %m%n</pattern>
        </encoder>
    </appender>

    <!-- 3. Xmpp Appender -->
    <appender name="XmppFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/xmpp.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/xmpp.%d{yyyyMMdd.HHmmss}.%i.gz</fileNamePattern>
            <maxFileSize>1000MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss:SSS} %m%n</pattern>
        </encoder>
    </appender>

    <!-- 4. Error Appender -->
    <appender name="ErrorFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error.%d{yyyyMMdd.HHmmss}.%i.gz</fileNamePattern>
            <maxFileSize>1000MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss:SSS} %m%n</pattern>
        </encoder>
    </appender>

    <!-- 5. Parsing Appender -->
    <appender name="ParsingFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/parsing.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/parsing.%d{yyyyMMdd.HHmmss}.%i.gz</fileNamePattern>
            <maxFileSize>1000MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss:SSS} %m%n</pattern>
        </encoder>
    </appender>

    <!-- 6. Debug Appender -->
    <appender name="DebugFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/debug.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/debug.%d{yyyyMMdd.HHmmss}.%i.gz</fileNamePattern>
            <maxFileSize>1000MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss:SSS} %m%n</pattern>
        </encoder>
    </appender>

    <!-- Loggers mapping (Sesuaikan dengan nama logger di code kamu) -->
    <logger name="stream" level="INFO" additivity="false">
        <appender-ref ref="StreamFileAppender" />
    </logger>

    <logger name="xmpp" level="INFO" additivity="false">
        <appender-ref ref="XmppFileAppender" />
    </logger>

    <logger name="error" level="INFO" additivity="false">
        <appender-ref ref="ErrorFileAppender" />
    </logger>

    <logger name="parsing" level="INFO" additivity="false">
        <appender-ref ref="ParsingFileAppender" />
    </logger>

    <logger name="debug" level="DEBUG" additivity="false">
        <appender-ref ref="DebugFileAppender" />
    </logger>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
